FROM ros:humble

# Test tooling for auction_core (pytest/hypothesis) and ROS launch testing.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-pytest \
        python3-numpy \
        python3-scipy \
        ros-humble-launch-testing \
        ros-humble-launch-testing-ros \
    && rm -rf /var/lib/apt/lists/* \
    # setuptools >= 64 for PEP 660 editable install of auction_core, but
    # < 66 so rosidl's egg build still matches Humble's packaging module
    && pip3 install --no-cache-dir -U pip "setuptools==65.7.0" \
    && pip3 install --no-cache-dir hypothesis

WORKDIR /ws
