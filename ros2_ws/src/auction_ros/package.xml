<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auction_ros</name>
  <version>0.1.0</version>
  <description>Thin ROS 2 wrapper hosting the auction_core coordination layer.
    NOTE: requires the auction_core Python package (pip install -e auction_core
    from the repo root) — it is deliberately not a rosdep dependency.</description>
  <maintainer email="technical.wanderer@gmail.com">Tom Le Huray</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>auction_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
